NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_NOVEL_API_URL=http://your-server:18080
NOVEL_API_URL=http://your-server:18080

# Neon PostgreSQL (Vercel Storage 会自动注入生产环境)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 管理后台 /admin
# ADMIN_PASSWORD_HASH 格式：scrypt$盐$哈希，不要填写明文密码
ADMIN_PASSWORD_HASH=scrypt$replace-with-salt$replace-with-hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
